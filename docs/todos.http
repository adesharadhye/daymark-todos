# Shared API origin used by each request below.
@baseUrl = http://127.0.0.1:3001

### Health
GET {{baseUrl}}/api/health

### List all todos
# Read data without changing it using the shared API URL.
GET {{baseUrl}}/api/todos

### Create a todo — run this before requests referencing createTodo
# @name createTodo
POST {{baseUrl}}/api/todos
Content-Type: application/json

{
  "title": "Prepare launch checklist",
  "description": "Review screenshots and release notes.",
  "priority": "high",
  "project": "work",
  "dueDate": "2027-06-15"
}

### Fetch the created todo
# Read data without changing it using the shared API URL.
GET {{baseUrl}}/api/todos/{{createTodo.response.body.$.todo.id}}

### Combine search and filters
GET {{baseUrl}}/api/todos?q=launch&completed=false&priority=high&project=work&sort=dueDate

### Edit only selected fields
# Change only the supplied fields on this task using the shared API URL.
PATCH {{baseUrl}}/api/todos/{{createTodo.response.body.$.todo.id}}
Content-Type: application/json

{
  "title": "Finalize launch checklist",
  "description": "All screenshots have been reviewed.",
  "priority": "medium"
}

### Complete
# Change only the supplied fields on this task using the shared API URL.
PATCH {{baseUrl}}/api/todos/{{createTodo.response.body.$.todo.id}}
Content-Type: application/json

{
  "completed": true
}

### Reopen
# Change only the supplied fields on this task using the shared API URL.
PATCH {{baseUrl}}/api/todos/{{createTodo.response.body.$.todo.id}}
Content-Type: application/json

{
  "completed": false
}

### Clear the due date
# Change only the supplied fields on this task using the shared API URL.
PATCH {{baseUrl}}/api/todos/{{createTodo.response.body.$.todo.id}}
Content-Type: application/json

{
  "dueDate": null
}

### Delete — subsequent requests for this ID return 404
# Permanently remove this task using the shared API URL.
DELETE {{baseUrl}}/api/todos/{{createTodo.response.body.$.todo.id}}

### Validation: blank title returns 400
POST {{baseUrl}}/api/todos
# Tell the server that the following body uses JSON; its fields are explained in CODE_GUIDE.md.
Content-Type: application/json

{
  "title": "   "
}

### Validation: nonexistent calendar date returns 400
# Create a new task from the JSON body using the shared API URL.
POST {{baseUrl}}/api/todos
Content-Type: application/json

{
  "title": "Invalid date example",
  "dueDate": "2027-02-29"
}

### Validation: invalid query returns 400
# Read data without changing it using the shared API URL.
GET {{baseUrl}}/api/todos?completed=maybe

### Missing record returns 404
GET {{baseUrl}}/api/todos/00000000-0000-4000-8000-000000000000
